# Backend Server Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/skillbridge
MONGODB_TEST_URI=mongodb://localhost:27017/skillbridge-test

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASEURL=http://localhost:5000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_this_in_production
JWT_REFRESH_EXPIRE=30d

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=noreply@skillbridge.io
EMAIL_FROM_NAME=SkillBridge

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Frontend Configuration
FRONTEND_URL=http://localhost:5174
FRONTEND_URL_PROD=https://skillbridge.example.com

# Third-party APIs
STRIPE_KEY=pk_test_your_stripe_key
STRIPE_SECRET=sk_test_your_stripe_secret

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# CORS Configuration
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# Session Configuration
SESSION_SECRET=your_session_secret_change_this_in_production
SESSION_TIMEOUT=86400000
