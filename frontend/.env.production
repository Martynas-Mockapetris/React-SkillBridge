# Frontend Production Environment Configuration
# This file is used during production builds

# API Configuration
VITE_API_URL=https://api.skillbridge.io
VITE_API_TIMEOUT=10000

# Application Configuration
VITE_APP_NAME=SkillBridge
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE=SkillBridge - Freelance Platform

# Environment
VITE_ENV=production
VITE_DEBUG=false

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# Third-party Services
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_key
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Development Server (not used in production)
VITE_HMR_HOST=
VITE_HMR_PORT=
VITE_HMR_PROTOCOL=

# Storage
VITE_MAX_UPLOAD_SIZE=52428800
VITE_STORAGE_PROVIDER=aws-s3

# Authentication
VITE_AUTH_TIMEOUT=7200000
VITE_REFRESH_TOKEN_INTERVAL=3600000

# UI Configuration
VITE_THEME_DEFAULT=light
VITE_ANIMATIONS_ENABLED=true

# Performance
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_STRATEGY=cache-first
