# Frontend Application Configuration
# Copy this file to .env.local for local development
# For production builds, use .env.production

# API Configuration
VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT=10000

# Application Configuration
VITE_APP_NAME=SkillBridge
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE=SkillBridge - Freelance Platform

# Environment
VITE_ENV=development
VITE_DEBUG=true

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# Third-party Services
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Development Server
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5174
VITE_HMR_PROTOCOL=ws

# Storage
VITE_MAX_UPLOAD_SIZE=10485760
VITE_STORAGE_PROVIDER=local

# Authentication
VITE_AUTH_TIMEOUT=3600000
VITE_REFRESH_TOKEN_INTERVAL=1800000

# UI Configuration
VITE_THEME_DEFAULT=light
VITE_ANIMATIONS_ENABLED=true

# Performance
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_STRATEGY=network-first
